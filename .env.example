# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Database (Neon) ---
# Local work uses the Neon `dev` branch. Both lines must point at the same branch.
# Warning: `neon deploy` / `neon env pull` rewrite DATABASE_URL with the owner login. Fix it afterwards.
# App connection: POOLED host (-pooler), user architrac_app (no BYPASSRLS; see src/db/sql/create-app-role.sql)
DATABASE_URL="postgresql://architrac_app:PASSWORD@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
# Owner connection: DIRECT host (no -pooler), user neondb_owner. Only for migrations, tests and seeding
DATABASE_URL_OWNER="postgresql://neondb_owner:PASSWORD@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require"
NEON_BRANCH=dev

# --- Auth (Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# --- Encryption for stored integration tokens (32 random bytes, base64) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Release 1 ---
# Email (Postmark or Resend — pick one)
EMAIL_FROM="ArchiTrac <no-reply@yourdomain.com>"
POSTMARK_SERVER_TOKEN=""
# RESEND_API_KEY=""

# File storage (Cloudflare R2, S3-compatible)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="architrac-dev"

# QuickBooks Online (use the sandbox keys while developing)
QBO_CLIENT_ID=""
QBO_CLIENT_SECRET=""
QBO_ENVIRONMENT="sandbox"   # sandbox | production
QBO_REDIRECT_URI="http://localhost:3000/api/integrations/quickbooks/callback"

# Error monitoring (Sentry). Leave the DSN empty locally to keep Sentry off.
# On Vercel, the DSN is set in the project's environment variables, and
# NEXT_PUBLIC_APP_ENV (production | preview) is set by the deploy workflows.
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_APP_ENV="development"

# Cron jobs (Vercel sends this as a bearer token)
CRON_SECRET=""

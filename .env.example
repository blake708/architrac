# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Database (Neon) ---
# App connection: a role WITHOUT table ownership or BYPASSRLS (row-level security applies)
DATABASE_URL="postgresql://architrac_app:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/architrac?sslmode=require"
# Owner connection: used only for migrations and seeding
DATABASE_URL_OWNER="postgresql://architrac_owner:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/architrac?sslmode=require"

# --- Auth (Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# --- Encryption for stored integration tokens (32 random bytes, base64) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Release 1 ---
# Email (Postmark or Resend — pick one)
EMAIL_FROM="ArchiTrac <no-reply@yourdomain.com>"
POSTMARK_SERVER_TOKEN=""
# RESEND_API_KEY=""

# File storage (Cloudflare R2, S3-compatible)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="architrac-dev"

# QuickBooks Online (use the sandbox keys while developing)
QBO_CLIENT_ID=""
QBO_CLIENT_SECRET=""
QBO_ENVIRONMENT="sandbox"   # sandbox | production
QBO_REDIRECT_URI="http://localhost:3000/api/integrations/quickbooks/callback"

# Error monitoring
SENTRY_DSN=""

# Cron jobs (Vercel sends this as a bearer token)
CRON_SECRET=""
